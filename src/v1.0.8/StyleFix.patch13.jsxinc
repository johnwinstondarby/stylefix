/* STYLEFIX_PATCH_PART: 1.0.8/13 */

/*
Stage-aware ScriptUI progress monitor.

Instrumentation only:
- does not alter audit, dependency, fingerprint, export-map, authorization, or
  classification logic;
- uses a standalone modeless palette so progress is visible while the main
  StyleFix results window is hidden during the initial scan;
- adds an overall native progressbar plus a stage-color accent and status text;
- derives major stage transitions from existing StyleFix status messages;
- adds throttled inner-loop checkpoints for story traversal, text ranges, and
  dependency-reference inspection so long phases repaint more often;
- adds no sleeps, artificial delays, cancellation, or mutation paths.

Stage accents:
- BLUE: inventory / direct-use scan
- VIOLET: dependency analysis
- GOLD: candidate classification / verification
- GREEN: complete
- RED: failed scan
*/

var styleFixProgress108 = {
    startedAt:0,
    lastPaintAt:0,
    running:false,
    failed:false,
    stage:"Ready",
    percent:0,
    current:0,
    total:0,
    color:"BLUE",
    mainVisibleAtStart:false,
    usageTotal:0,
    usageCurrent:0,
    usageRanges:0,
    dependencyChecks:0
};

var styleFixBuildUIBeforeProgress108 = buildUI;
var styleFixStatusBeforeProgress108 = status;
var styleFixScanBeforeProgress108 = scan;
var styleFixScanTextContainerBeforeProgress108 = scanTextContainer;
var styleFixRecordUsageRangeBeforeProgress108 = recordUsageRange;
var styleFixRecordDependencyRefBeforeProgress108 = recordDependencyRef;

buildUI = function () {
    styleFixBuildUIBeforeProgress108();
    styleFixInstallMainShowHook108();
    styleFixOpenProgressWindow108();
};

status = function (text) {
    styleFixStatusBeforeProgress108(text);
    styleFixProgressFromStatus108(text);
};

scan = function () {
    styleFixProgress108.mainVisibleAtStart = styleFixMainWindowVisible108();
    styleFixOpenProgressWindow108();
    styleFixProgressStart108();
    styleFixScanBeforeProgress108();
    if (styleFixProgress108.failed !== true && styleFixProgress108.running === true) {
        styleFixProgressComplete108();
    }

    /* During the initial launch the main StyleFix window has not been shown
       yet. Keep the completed progress palette visible until ui.win.onShow
       fires, so the transition is Progress -> Results with no blank interval.
       For a later Rescan the main window is already visible, so dismiss the
       progress palette as soon as that scan finishes. */
    if (styleFixProgress108.mainVisibleAtStart === true) {
        styleFixCloseProgressWindow108();
    }
};

/* Top-level story checkpoints. Nested tables and notes still run through the
   original scanner, but they do not inflate the story denominator. */
scanTextContainer = function (container,label,audit,context,tableDepth,scanNotes) {
    var isTop = styleFixIsTopLevelStory108(label,context,tableDepth);
    if (isTop && styleFixProgress108.running === true &&
        styleFixProgress108.stage === "Usage traversal") {
        styleFixProgress108.usageCurrent++;
        styleFixProgress108.current = styleFixProgress108.usageCurrent;
        styleFixProgress108.total = styleFixProgress108.usageTotal;
        styleFixProgress108.percent = styleFixUsagePercent108(
            styleFixProgress108.usageCurrent,
            styleFixProgress108.usageTotal
        );
        styleFixPaintProgress108(
            "Scanning story " + styleFixProgress108.usageCurrent +
            (styleFixProgress108.usageTotal > 0 ?
                " of " + styleFixProgress108.usageTotal : "") + "...",
            true
        );
    }
    return styleFixScanTextContainerBeforeProgress108(
        container,label,audit,context,tableDepth,scanNotes
    );
};

/* Text-range heartbeat. This catches long stories containing many style ranges
   without repainting on every range. The normal 75 ms paint throttle remains
   in force. */
recordUsageRange = function (range,audit,context,tableDepth) {
    var result = styleFixRecordUsageRangeBeforeProgress108(range,audit,context,tableDepth);
    if (styleFixProgress108.running === true &&
        styleFixProgress108.stage === "Usage traversal") {
        styleFixProgress108.usageRanges++;
        if (styleFixProgress108.usageRanges % 25 === 0) {
            styleFixPaintProgress108(
                "Text ranges checked: " + styleFixProgress108.usageRanges,
                false
            );
        }
    }
    return result;
};

/* Dependency heartbeat. recordDependencyRef is the common reference-inspection
   path across the dependency index. Counting calls gives an activity signal,
   not a claimed denominator. */
recordDependencyRef = function (audit,ref,detail) {
    var result;
    if (styleFixProgress108.running === true &&
        styleFixProgress108.stage === "Dependency analysis") {
        styleFixProgress108.dependencyChecks++;
        if (styleFixProgress108.dependencyChecks % 10 === 0) {
            styleFixProgress108.percent = styleFixDependencyPercent108(
                styleFixProgress108.dependencyChecks
            );
            styleFixPaintProgress108(
                "Dependency references checked: " +
                    styleFixProgress108.dependencyChecks,
                false
            );
        }
    }
    result = styleFixRecordDependencyRefBeforeProgress108(audit,ref,detail);
    return result;
};

function styleFixInstallMainShowHook108() {
    var previousOnShow = null;
    try { previousOnShow = ui.win.onShow; } catch (ignoreRead) {}
    try {
        ui.win.onShow = function () {
            try {
                if (previousOnShow && typeof previousOnShow === "function") {
                    previousOnShow.call(this);
                }
            } catch (ignorePrevious) {}
            styleFixCloseProgressWindow108();
        };
    } catch (ignoreHook) {}
}

function styleFixMainWindowVisible108() {
    try { return ui.win && ui.win.visible === true; } catch (ignoreVisible) {}
    return false;
}

function styleFixOpenProgressWindow108() {
    var win, header;

    try {
        if (ui.progressWin108 && ui.progressWin108.visible === true) {
            return;
        }
    } catch (ignoreExisting) {}

    try { styleFixCloseProgressWindow108(); } catch (ignoreClose) {}

    try {
        win = new Window("palette", "StyleFix v" + VERSION + " - Working");
        win.orientation = "column";
        win.alignChildren = ["fill","top"];
        win.margins = 14;
        win.spacing = 7;
        ui.progressWin108 = win;

        header = win.add("group");
        header.orientation = "row";
        header.alignChildren = ["left","center"];

        ui.progressStage108 = header.add("statictext", undefined, "Ready");
        ui.progressStage108.preferredSize = [250,22];
        try {
            ui.progressStage108.graphics.font = ScriptUI.newFont(
                ui.progressStage108.graphics.font.name,"BOLD",11
            );
        } catch (ignoreFont) {}

        ui.progressCount108 = header.add("statictext", undefined, "");
        ui.progressCount108.preferredSize = [140,22];

        ui.progressElapsed108 = header.add("statictext", undefined, "Elapsed 0:00");
        ui.progressElapsed108.alignment = ["right","center"];
        ui.progressElapsed108.preferredSize = [150,22];

        ui.progressAccent108 = win.add("panel", undefined, "");
        ui.progressAccent108.preferredSize = [600,6];
        ui.progressAccent108.minimumSize = [360,6];
        ui.progressAccent108.maximumSize = [1200,6];

        ui.progressBar108 = win.add("progressbar", undefined, 0, 100);
        ui.progressBar108.preferredSize = [600,18];
        ui.progressBar108.minimumSize = [360,18];

        ui.progressOperation108 = win.add("statictext", undefined, "Preparing StyleFix...", {multiline:true});
        ui.progressOperation108.preferredSize = [600,38];

        styleFixSetProgressColor108("BLUE");
        win.center();
        win.show();
        try { win.update(); } catch (ignoreUpdate) {}
    } catch (ignoreProgressUI) {
        /* Progress UI is advisory. A platform-specific ScriptUI limitation must
           never block the audit itself. */
    }
}

function styleFixCloseProgressWindow108() {
    try {
        if (ui.progressWin108) {
            try { ui.progressWin108.hide(); } catch (ignoreHide) {}
            try { ui.progressWin108.close(); } catch (ignoreClose) {}
        }
    } catch (ignoreWindow) {}

    ui.progressWin108 = null;
    ui.progressStage108 = null;
    ui.progressCount108 = null;
    ui.progressElapsed108 = null;
    ui.progressAccent108 = null;
    ui.progressBar108 = null;
    ui.progressOperation108 = null;
}

function styleFixProgressStart108() {
    styleFixProgress108.startedAt = (new Date()).getTime();
    styleFixProgress108.lastPaintAt = 0;
    styleFixProgress108.running = true;
    styleFixProgress108.failed = false;
    styleFixProgress108.stage = "Inventory / fingerprint";
    styleFixProgress108.percent = 5;
    styleFixProgress108.current = 0;
    styleFixProgress108.total = 0;
    styleFixProgress108.color = "BLUE";
    styleFixProgress108.usageTotal = styleFixStoryCount108();
    styleFixProgress108.usageCurrent = 0;
    styleFixProgress108.usageRanges = 0;
    styleFixProgress108.dependencyChecks = 0;
    styleFixPaintProgress108("Preparing style inventory and fingerprint schema...",true);
}

function styleFixProgressFromStatus108(text) {
    var value = String(text || ""), match, current, total, percent;

    if (/^Scan failed:/i.test(value)) {
        styleFixProgress108.failed = true;
        styleFixProgress108.running = false;
        styleFixProgress108.stage = "Failed";
        styleFixProgress108.percent = 100;
        styleFixProgress108.current = 0;
        styleFixProgress108.total = 0;
        styleFixProgress108.color = "RED";
        styleFixPaintProgress108(value,true);
        return;
    }

    if (/^Scanning direct usage/i.test(value)) {
        styleFixProgress108.stage = "Usage traversal";
        styleFixProgress108.percent = 28;
        styleFixProgress108.current = 0;
        styleFixProgress108.total = styleFixProgress108.usageTotal;
        styleFixProgress108.color = "BLUE";
        styleFixPaintProgress108(value,true);
        return;
    }

    if (/^Indexing dependencies/i.test(value)) {
        styleFixProgress108.stage = "Dependency analysis";
        styleFixProgress108.percent = 52;
        styleFixProgress108.current = 0;
        styleFixProgress108.total = 0;
        styleFixProgress108.color = "VIOLET";
        styleFixPaintProgress108(value,true);
        return;
    }

    match = value.match(/^Auditing\s+(\d+)\s+of\s+(\d+):/i);
    if (match) {
        current = Number(match[1]);
        total = Number(match[2]);
        percent = 60;
        if (total > 0) {
            percent += Math.floor((current / total) * 36);
        }
        if (percent > 96) { percent = 96; }
        styleFixProgress108.stage = "Classification / verification";
        styleFixProgress108.percent = percent;
        styleFixProgress108.current = current;
        styleFixProgress108.total = total;
        styleFixProgress108.color = "GOLD";
        styleFixPaintProgress108(value,false);
        return;
    }

    if (/^Scan complete\./i.test(value)) {
        styleFixProgress108.running = false;
        styleFixProgress108.stage = "Complete";
        styleFixProgress108.percent = 100;
        styleFixProgress108.current = styleFixProgress108.total;
        styleFixProgress108.color = "GREEN";
        styleFixPaintProgress108(value,true);
        return;
    }

    if (styleFixProgress108.running === true) {
        styleFixPaintProgress108(value,false);
    }
}

function styleFixProgressComplete108() {
    styleFixProgress108.running = false;
    styleFixProgress108.stage = "Complete";
    styleFixProgress108.percent = 100;
    styleFixProgress108.current = styleFixProgress108.total;
    styleFixProgress108.color = "GREEN";
    styleFixPaintProgress108("Scan complete.",true);
}

function styleFixPaintProgress108(operation,force) {
    var now = (new Date()).getTime();
    var elapsed, countText = "";

    if (force !== true && now - styleFixProgress108.lastPaintAt < 75) { return; }
    styleFixProgress108.lastPaintAt = now;

    elapsed = styleFixElapsedText108(now - styleFixProgress108.startedAt);
    if (styleFixProgress108.total > 0) {
        countText = String(styleFixProgress108.current) + " / " + String(styleFixProgress108.total);
    } else if (styleFixProgress108.stage === "Dependency analysis" &&
        styleFixProgress108.dependencyChecks > 0) {
        countText = String(styleFixProgress108.dependencyChecks) + " checks";
    }

    try { if (ui.progressStage108) { ui.progressStage108.text = styleFixProgress108.stage; } } catch (ignoreStage) {}
    try { if (ui.progressCount108) { ui.progressCount108.text = countText; } } catch (ignoreCount) {}
    try { if (ui.progressElapsed108) { ui.progressElapsed108.text = "Elapsed " + elapsed; } } catch (ignoreElapsed) {}
    try {
        if (ui.progressBar108) {
            ui.progressBar108.value = styleFixProgress108.percent;
        }
    } catch (ignoreBar) {}
    try { if (ui.progressOperation108) { ui.progressOperation108.text = String(operation || ""); } } catch (ignoreOp) {}

    styleFixSetProgressColor108(styleFixProgress108.color);
    try { if (ui.progressWin108) { ui.progressWin108.update(); } } catch (ignoreUpdate) {}
}

function styleFixIsTopLevelStory108(label,context,tableDepth) {
    var text = String(label || "");
    if (Number(tableDepth) !== 0) { return false; }
    if (context !== "STORY" && context !== "ENDNOTE") { return false; }
    return /^(Story|Endnote story)\s/i.test(text);
}

function styleFixStoryCount108() {
    var doc, stories;
    try {
        if (app.documents.length === 0) { return 0; }
        doc = app.activeDocument;
        stories = collectionElements(safePropertyObject(doc,"stories"));
        return stories.length;
    } catch (ignoreStories) {}
    return 0;
}

function styleFixUsagePercent108(current,total) {
    var value = 28;
    if (total > 0) {
        value += Math.floor((current / total) * 21);
    }
    if (value > 49) { value = 49; }
    return value;
}

function styleFixDependencyPercent108(checks) {
    var value = 52 + Math.floor(Number(checks || 0) / 30);
    if (value > 59) { value = 59; }
    return value;
}

function styleFixSetProgressColor108(key) {
    var color = styleFixProgressColor108(key), g;

    try {
        if (ui.progressStage108) {
            g = ui.progressStage108.graphics;
            g.foregroundColor = g.newPen(g.PenType.SOLID_COLOR,color,1);
        }
    } catch (ignoreStageColor) {}

    try {
        if (ui.progressAccent108) {
            g = ui.progressAccent108.graphics;
            g.backgroundColor = g.newBrush(g.BrushType.SOLID_COLOR,color);
        }
    } catch (ignoreAccentColor) {}
}

function styleFixProgressColor108(key) {
    if (key === "VIOLET") { return [0.48,0.28,0.82,1]; }
    if (key === "GOLD") { return [0.82,0.58,0.12,1]; }
    if (key === "GREEN") { return [0.20,0.62,0.32,1]; }
    if (key === "RED") { return [0.78,0.18,0.18,1]; }
    return [0.18,0.45,0.82,1];
}

function styleFixElapsedText108(milliseconds) {
    var seconds, minutes, remainder;
    if (milliseconds < 0 || isNaN(milliseconds)) { milliseconds = 0; }
    seconds = Math.floor(milliseconds / 1000);
    minutes = Math.floor(seconds / 60);
    remainder = seconds - (minutes * 60);
    return String(minutes) + ":" + (remainder < 10 ? "0" : "") + String(remainder);
}
