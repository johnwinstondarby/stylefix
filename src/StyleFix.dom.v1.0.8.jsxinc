/* Export tag map */
domRegister108("EXPORT_MAP_TYPE","exportType","property","StyleExportTagMap","EXPORT",true);
domRegister108("EXPORT_MAP_TAG","exportTag","property","StyleExportTagMap","EXPORT",true);
