domRegister108("FOOTNOTE_MARKER_STYLE","footnoteMarkerStyle","property","FootnoteOption","DEPENDENCY",true);
domRegister108("ENDNOTE_MARKER_STYLE","endnoteMarkerStyle","property","EndnoteOption","DEPENDENCY",true);
domRegister108("INDEX_PAGE_NUMBER_STYLE","pageNumberStyle","property","IndexOptions","DEPENDENCY",true);
domRegister108("INDEX_CROSS_REFERENCE_STYLE","crossReferenceStyle","property","IndexOptions","DEPENDENCY",true);
