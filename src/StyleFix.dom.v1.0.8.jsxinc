/* Style identity / usage */
domRegister108("STYLE_NAME","name","property","Style","STYLE",true);
domRegister108("STYLE_ID","id","property","Style","STYLE",true);
domRegister108("STYLE_IMPORTED","imported","property","CharacterStyle","STYLE",false);
domRegister108("STYLE_BASED_ON","basedOn","property","CharacterStyle","DEPENDENCY",true);
domRegister108("CHAR_APPLIED_STYLE","appliedCharacterStyle","property","Character/TextRange","USAGE",true);
domRegister108("STYLE_EXPORT_TAG_MAPS","styleExportTagMaps","property","CharacterStyle","EXPORT",true);

/* Generic collection operations used where everyItem().getElements() is unsafe */
domRegister108("COLLECTION_LENGTH","length","property","Collection","COLLECTION",true);
domRegister108("COLLECTION_COUNT","count","method","Collection","COLLECTION",false);
domRegister108("COLLECTION_ITEM","item","method","Collection","COLLECTION",true);
domRegister108("COLLECTION_ADD","add","method","Collection","COLLECTION",false);
domRegister108("COLLECTION_EVERY_ITEM","everyItem","method","Collection","COLLECTION",false);
domRegister108("OBJECT_GET_ELEMENTS","getElements","method","ObjectSpecifier","COLLECTION",false);
domRegister108("OBJECT_TO_SPECIFIER","toSpecifier","method","Object","IDENTITY",false);
domRegister108("OBJECT_IS_VALID","isValid","property","Object","IDENTITY",false);
