domRegister108("PARA_DROP_CAP_STYLE","dropCapStyle","property","ParagraphStyle","DEPENDENCY",true);
domRegister108("PARA_BULLETS_STYLE","bulletsCharacterStyle","property","ParagraphStyle","DEPENDENCY",true);
