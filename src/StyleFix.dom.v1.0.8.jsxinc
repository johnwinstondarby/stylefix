domRegister108("FP_OVERPRINT_STROKE","overprintStroke","property","CharacterStyle","FINGERPRINT",true);

/* Names used by legacy helpers but not themselves release-gating contracts. */
(function () {
    var names = [
        "modified","filePath","label","index","untranslatedName","fullName",
        "parentPage","parentTextFrames","parentStory","textContainers","contents",
        "characters","insertionPoints","name","id","imported","basedOn",
        "appliedCharacterStyle","appliedStyle","styleExportTagMaps","exportType",
        "exportTag","exportClass","exportAttributes","isValid","documentOffset",
        "pageNumberStyle","separatorStyle","dropCapStyle","bulletsCharacterStyle",
        "numberingCharacterStyle","nestedStyles","nestedGrepStyles","nestedLineStyles",
        "variableOptions","buildingBlocks","tocStyleEntries","footnoteMarkerStyle",
        "endnoteMarkerStyle","crossReferenceStyle","crossReferenceTopicStyle",
        "allTopics","pageReferences","pageNumberStyleOverride","mappedStyle",
        "fullName","textStyleRanges","tables","cells","texts","footnotes",
        "isEndnoteStory","storyType","overflows","endnoteTextFrames",
        "allCharacterStyles","allParagraphStyles","textVariables",
        "crossReferenceFormats","hyperlinkTextSources","crossReferenceSources",
        "tocStyles","footnoteOptions","endnoteOptions","indexGenerationOptions",
        "indexes","xmlImportMaps","xmlExportMaps","stories","swatches","fonts",
        "languagesWithVendors","version","buildNumber"
    ];
    var i;
    for (i = 0; i < names.length; i++) {
        if (DOM108_BY_NAME[names[i]] === undefined) {
            domRegister108("LEGACY_" + i, names[i], "property", "Legacy", "AUX", false);
        }
    }
}());

function domEntry108(code) {
    var entry = DOM108[code];
    if (entry === undefined) {
        throw new Error("StyleFix DOM contract error: unregistered contract key " + code);
    }
    return entry;
}

function domAssertRegisteredName108(name) {
    if (DOM108_BY_NAME[name] === undefined) {
        throw new Error("StyleFix DOM contract error: unregistered DOM name '" + name + "'");
    }
}

function domGet108(obj, code) {
    var entry = domEntry108(code);
    if (entry.kind !== "property") {
        throw new Error("StyleFix DOM contract error: " + code + " is not a property contract");
    }
    if (obj === null || obj === undefined) {
        throw new Error("StyleFix DOM contract error: null object for " + code);
    }
    try { if (typeof domGate108 === "function") { domGate108(code); } } catch (eGate) { throw eGate; }
    return obj[entry.name];
}

function domTryGet108(obj, code) {
    var entry = domEntry108(code), value, n = 0, message = "";
    if (entry.kind !== "property") {
        return {state:"FAILED", value:null, note:"Contract is not a property."};
    }
    if (obj === null || obj === undefined) {
        return {state:"NO_INSTANCE", value:null, note:"No representative object."};
    }
    try {
        value = obj[entry.name];
        if (value === undefined) {
            return {state:"NOT_EXPOSED", value:null, note:"Property returned undefined."};
        }
        return {state:"SUPPORTED", value:value, note:""};
    } catch (e) {
        try { n = Number(e.number); } catch (ignoreN) {}
        try { message = String(e.message || e); } catch (ignoreM) {}
        if (n === 55 || message.indexOf("does not support") >= 0) {
            return {state:"NOT_EXPOSED", value:null, note:message};
        }
        return {state:"FAILED", value:null, note:message};
    }
}

function domCall108(obj, code, args) {
    var entry = domEntry108(code), fn;
    if (entry.kind !== "method") {
        throw new Error("StyleFix DOM contract error: " + code + " is not a method contract");
    }
    if (obj === null || obj === undefined) {
        throw new Error("StyleFix DOM contract error: null object for " + code);
    }
    try { if (typeof domGate108 === "function") { domGate108(code); } } catch (eGate) { throw eGate; }
    fn = obj[entry.name];
    if (typeof fn !== "function") {
        throw new Error("StyleFix DOM contract error: method unavailable for " + code + " (" + entry.name + ")");
    }
    if (args === null || args === undefined) { args = []; }
    return fn.apply(obj,args);
}

function domTryMethod108(obj, code) {
    var entry = domEntry108(code), fn, n = 0, message = "";
    if (entry.kind !== "method") {
        return {state:"FAILED", value:null, note:"Contract is not a method."};
    }
    if (obj === null || obj === undefined) {
        return {state:"NO_INSTANCE", value:null, note:"No representative object."};
    }
    try {
        fn = obj[entry.name];
        if (typeof fn !== "function") {
            return {state:"NOT_EXPOSED", value:null, note:"Method is not callable."};
        }
        return {state:"SUPPORTED", value:fn, note:""};
    } catch (e) {
        try { n = Number(e.number); } catch (ignoreN) {}
        try { message = String(e.message || e); } catch (ignoreM) {}
        if (n === 55 || message.indexOf("does not support") >= 0) {
            return {state:"NOT_EXPOSED", value:null, note:message};
        }
        return {state:"FAILED", value:null, note:message};
    }
}

function domRegisteredSummary108() {
    var out = [], code, entry;
    for (code in DOM108) {
        if (!DOM108.hasOwnProperty(code)) { continue; }
        entry = DOM108[code];
        if (entry.required) { out.push(code + "=" + entry.name + "@" + entry.surface); }
    }
    out.sort();
    return out.join(" | ");
}
