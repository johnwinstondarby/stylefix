/* Fingerprint properties */
domRegister108("FP_APPLIED_FONT","appliedFont","property","CharacterStyle","FINGERPRINT",true);
domRegister108("FP_FONT_STYLE","fontStyle","property","CharacterStyle","FINGERPRINT",true);
domRegister108("FP_POINT_SIZE","pointSize","property","CharacterStyle","FINGERPRINT",true);
