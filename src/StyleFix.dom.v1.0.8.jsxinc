domRegister108("PARA_NESTED_GREP_STYLES","nestedGrepStyles","property","ParagraphStyle","DEPENDENCY",true);
domRegister108("PARA_NESTED_LINE_STYLES","nestedLineStyles","property","ParagraphStyle","DEPENDENCY",true);
domRegister108("NESTED_APPLIED_CHARACTER_STYLE","appliedCharacterStyle","property","NestedStyle","DEPENDENCY",true);
domRegister108("NESTED_APPLIED_STYLE","appliedStyle","property","NestedStyle/BuildingBlock","DEPENDENCY",false);
domRegister108("VARIABLE_OPTIONS","variableOptions","property","TextVariable","DEPENDENCY",true);
