/* STYLEFIX_DOM_CONTRACT_VERSION: 1.0.8
StyleFix v1.0.8 DOM contract registry.

All safety-relevant DOM property/method names used by the v1.0.8 scanner are
registered here. New v1.0.8 code resolves names through domGet108/domCall108.
Legacy helper accessors are wrapped by the v1.0.8 patch so an unregistered
property name fails loudly instead of silently degrading evidence.
*/

var STYLEFIX_DOM_CONTRACT_VERSION = "1.0.8";
var DOM108 = {};
var DOM108_BY_NAME = {};

function domRegister108(code, name, kind, surface, role, required) {
    var entry = {
        code:code,
        name:name,
        kind:kind || "property",
        surface:surface || "",
        role:role || "AUX",
        required:required === true
    };
    DOM108[code] = entry;
    if (DOM108_BY_NAME[name] === undefined) { DOM108_BY_NAME[name] = []; }
    DOM108_BY_NAME[name].push(entry);
}

/* Application / document */
domRegister108("APP_VERSION","version","property","Application","PROVENANCE",false);
domRegister108("APP_BUILD_NUMBER","buildNumber","property","Application","PROVENANCE",false);
domRegister108("APP_FONTS","fonts","property","Application","FINGERPRINT",true);
domRegister108("APP_LANGUAGES","languagesWithVendors","property","Application","FINGERPRINT",false);
domRegister108("APP_BOOKS","books","property","Application","BOOK",true);
domRegister108("DOC_STORIES","stories","property","Document","USAGE",true);
domRegister108("DOC_ALL_CHARACTER_STYLES","allCharacterStyles","property","Document","STYLE",true);
